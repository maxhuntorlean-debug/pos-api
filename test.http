@host = https://pos-api.lateshoy.workers.dev

###############################################################################
# AUTH
###############################################################################

### Bootstrap первого администратора
POST {{host}}/api/auth/bootstrap
Content-Type: application/json

{
  "name": "Administrator",
  "username": "admin",
  "password": "Pizda2000"
}


### Повторный bootstrap — ожидаем 409
POST {{host}}/api/auth/bootstrap
Content-Type: application/json

{
  "name": "Administrator",
  "username": "admin",
  "password": "Test12345"
}


### Login admin
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "Pizda2000"
}


### Me
GET {{host}}/api/auth/me


### Неверный пароль — ожидаем 401
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "wrong-password"
}


###############################################################################
# REGISTER
###############################################################################

### Register обычного пользователя
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "name": "Test User",
  "username": "testuser",
  "password": "Test12345"
}


###############################################################################
# USERS
###############################################################################

### Список пользователей
GET {{host}}/api/admin/users


### Получить пользователя ID 1
GET {{host}}/api/admin/users/1


### Создать пользователя
POST {{host}}/api/admin/users
Content-Type: application/json

{
  "name": "Second User",
  "username": "user2",
  "password": "Test12345",
  "roleId": 2
}


### Изменить пользователя
PUT {{host}}/api/admin/users/2
Content-Type: application/json

{
  "name": "Updated User",
  "roleId": 2,
  "active": true
}


### Заблокировать пользователя
PUT {{host}}/api/admin/users/2
Content-Type: application/json

{
  "name": "Updated User",
  "roleId": 2,
  "active": false
}


### Включить пользователя
PUT {{host}}/api/admin/users/2
Content-Type: application/json

{
  "name": "Updated User",
  "roleId": 2,
  "active": true
}


### Сменить пароль пользователя
PUT {{host}}/api/admin/users/2/password
Content-Type: application/json

{
  "password": "NewTest12345"
}


###############################################################################
# ROLES
###############################################################################

### Все роли
GET {{host}}/api/admin/roles


### Все permissions
GET {{host}}/api/admin/roles/permissions


### Права admin
GET {{host}}/api/admin/roles/1/permissions


### Права user
GET {{host}}/api/admin/roles/2/permissions


###############################################################################
# PERMISSIONS
###############################################################################

### Создать тестовое permission
POST {{host}}/api/admin/roles/permissions
Content-Type: application/json

{
  "code": "test.read",
  "name": "Read test data",
  "groupName": "test"
}


### Изменить test.read
# Подставь реальный ID из ответа предыдущего запроса
PUT {{host}}/api/admin/roles/permissions/9
Content-Type: application/json

{
  "code": "test.read",
  "name": "Read test",
  "groupName": "test"
}


###############################################################################
# ROLE PERMISSIONS
###############################################################################

### Выдать роли user users.read
PUT {{host}}/api/admin/roles/2/permissions
Content-Type: application/json

{
  "permissionIds": [2]
}


###############################################################################
# LOGOUT
###############################################################################

### Logout
POST {{host}}/api/auth/logout


### После logout — ожидаем 401
GET {{host}}/api/auth/me